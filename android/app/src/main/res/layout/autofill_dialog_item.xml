<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#FFFFFF"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Avatar Medallion with initial letter -->
    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/autofill_avatar_bg">

        <TextView
            android:id="@+id/dialog_item_avatar_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="P"
            android:textColor="#0D533A"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Credential Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp">

        <!-- Username / Email as the bold primary text -->
        <TextView
            android:id="@+id/dialog_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="username@example.com"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- App name + security badge as subtitle -->
        <TextView
            android:id="@+id/dialog_item_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Instagram • PassManage"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Right Chevron Selector -->
    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_autofill_chevron"
        android:contentDescription="Select" />

</LinearLayout>
